---
import Layout from "../../layouts/Base.astro";
import { site } from "../../data/site";
---

<Layout
  title="Arbeiten bei uns | Caliqua-Bormann"
  description="Arbeitgeber und Ausbildungsbetrieb in München: Gleitzeit, 13. Gehalt, 30 Urlaubstage, 4-Tage-Woche im Anlagenbau und flache Hierarchien."
>
  <div class="wrap">
    <header class="page-head">
      <h1>Ausbildungsbetrieb und Arbeitgeber</h1>
      <p class="lead">
        Als mittelständisches Familienunternehmen liegen wir zwischen Kleinbetrieb
        und Konzern. Die mitarbeiterbezogene Unternehmenskultur ist Teil des
        zertifizierten Qualitätsmanagementsystems.
      </p>
    </header>
    <p class="hero-actions page-actions">
      <a class="cta" href="mailto:bewerbung@caliqua-bormann.de">Jetzt bewerben</a>
      <a class="cta cta-ghost" href="/karriere/stellenangebote">Stellenangebote</a>
      <a class="cta cta-ghost" href="/karriere/ausbildung">Ausbildung 2026</a>
    </p>
    <div class="grid-2">
      <article class="panel">
        <h2>Arbeitszeit</h2>
        <p>
          Gleitzeit, flexible Modelle, Jahresarbeitszeitsystem, Homeoffice nach
          Möglichkeit im Büro, 30 Tage Urlaub mit kurzfristiger Beantragung,
          4-Tage-Woche im Anlagenbau.
        </p>
      </article>
      <article class="panel">
        <h2>Vergütung</h2>
        <p>
          Übertarifliche Vergütung, 13. Monatsgehalt, Zuschuss zur betrieblichen
          Altersvorsorge, Fahrgeld und Auslöse für Montagepersonal, Arbeitskleidung.
        </p>
      </article>
      <article class="panel">
        <h2>Aufstieg</h2>
        <p>
          Vom Anlagenmechaniker-Azubi zur Führungskraft: bauleitender Obermonteur,
          Montagemeister, Fachkraft für Arbeitssicherheit oder Projektleiter im
          Büro. Quereinstieg in den Kundendienst-Innendienst war möglich.
        </p>
      </article>
      <article class="panel">
        <h2>Fürsorge</h2>
        <p>
          Betriebsarzt, Betriebsrat, AGG-Beauftragte, eigene Fachkraft für
          Arbeitssicherheit. Hilfe in Notlagen. Direkter Weg zur Geschäftsführung.
        </p>
      </article>
      <article class="panel">
        <h2>Büro und Umfeld</h2>
        <p>
          Kostenlose Parkplätze, U-Bahn und Bus in der Nähe, Pausenräume und
          Sonnenterrasse, klimatisiertes Büro, Obst und Getränke, günstige
          Mittagsmenüs.
        </p>
      </article>
      <article class="panel">
        <h2>Für Azubis Anlagenmechaniker</h2>
        <p>
          Fahrgeldzuschuss, Notengeld, 37 Wochenstunden statt tariflich 40,
          4-Tage-Woche, Ausbildungsquote nach Bedarf – damit hohe
          Übernahmewahrscheinlichkeit.
        </p>
      </article>
    </div>

    <p class="block-head">
      Bewerbungen nur per E-Mail an
      <a href="mailto:bewerbung@caliqua-bormann.de">bewerbung@caliqua-bormann.de</a>,
      keine Papierunterlagen. Profil bei
      <a href={site.kununu} rel="nofollow noopener">kununu</a>
      und
      <a href={site.linkedin} rel="nofollow noopener">LinkedIn</a>.
    </p>
  </div>
</Layout>

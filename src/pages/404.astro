---
import Layout from "../layouts/Base.astro";
import { withBase } from "../lib/paths";
---

<Layout
  title="Seite nicht gefunden | Caliqua-Bormann"
  description="Die aufgerufene Seite existiert nicht. Zur Startseite der CALIQUA-BORMANN GmbH & Co. KG."
>
  <div class="wrap">
    <header class="page-head">
      <h1>Seite nicht gefunden</h1>
      <p class="lead">Die Adresse existiert auf der neuen Website nicht. Alte Contao-Pfade unter /index.php sollten per 301 umgeleitet werden.</p>
    </header>
    <p><a href={withBase("/")}>Zur Startseite</a> · <a href={withBase("/kontakt")}>Kontakt</a></p>
  </div>
</Layout>

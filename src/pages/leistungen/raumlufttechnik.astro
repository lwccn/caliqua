      },
      {
        title: "Vom Bedarf bis zum Notdienst",
        items: ["Bedarfsanalyse", "Beratung und Konzeption", "Planung", "Ausführung auf eigener oder Fremdplanung", "Wartung und Notdienst"],
      },
    ]}
  />
</Layout>
